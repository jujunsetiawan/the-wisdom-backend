{
  "name": "the-wisdom-api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node ./bin/index.js --host",
    "dev": "nodemon --legacy-watch ./bin/index.js --host",
    "test": "node test.js",
    "docker:build": "docker build -t wisdom-backend .",
    "docker:start:bash": "sh -c 'docker run -p 3000:3000 -v \"$(pwd):/app\" -v /app/node_modules wisdom-backend'",
    "docker:start:powershell": "powershell -Command \"docker run -p 3000:3000 -v ${PWD}:/app -v /app/node_modules wisdom-backend\"",
    "migrate:up": "npx sequelize-cli db:migrate",
    "migrate:undo": "npx sequelize-cli db:migrate:undo",
    "migrate:undo:all": "npx sequelize db:migrate:undo:all",
    "seed:up": "npx sequelize db:seed:all"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "debug": "~2.6.9",
    "dotenv": "^16.4.5",
    "express": "~4.16.1",
    "fastest-validator": "^1.18.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.2",
    "midtrans-client": "^1.3.1",
    "morgan": "~1.9.1",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.9.7",
    "sequelize": "^6.37.3",
    "sequelize-cli": "^6.6.2"
  },
  "description": "",
  "main": "app.js",
  "bin": {
    "the-wisdom-api": "bin/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jujunsetiawan/the-wisdom-backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/jujunsetiawan/the-wisdom-backend/issues"
  },
  "homepage": "https://github.com/jujunsetiawan/the-wisdom-backend#readme",
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
